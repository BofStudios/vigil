<Window x:Class="Vigil.UI.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vigil" Width="1120" Height="760" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0F1013"
        FontFamily="{StaticResource Sans}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ sidebar -->
        <Border x:Name="Sidebar" Background="#0AFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,26" WindowChrome.IsHitTestVisibleInChrome="False">
                    <Grid Width="30" Height="30">
                        <Ellipse Fill="{StaticResource CoreBloom}" Opacity="0.55" />
                        <Ellipse Width="26" Height="26" Stroke="{StaticResource CoreRing}" StrokeThickness="1.4" />
                        <Viewbox Width="11" Height="11">
                            <Canvas Width="256" Height="256">
                                <Path Data="{StaticResource MarkGeometry}" Stroke="{StaticResource Accent}" StrokeThickness="26"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="Vigil" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border CornerRadius="10" Padding="11,9" Background="#0DFFFFFF" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AwareDot" Width="7" Height="7" Fill="{StaticResource Safe}" VerticalAlignment="Center" Margin="0,1,9,0" />
                            <TextBlock x:Name="AwareText" Text="Awareness on" FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="OpenMind" Style="{StaticResource Bare}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="11,8" Tag="9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="13" Margin="0,0,10,0" />
                            <TextBlock Text="Open Vigil Mind folder" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavToday" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Today" IsChecked="True" GroupName="nav" />
                    <RadioButton x:Name="NavNotes" Style="{StaticResource Nav}" Tag="&#xE70B;" Content="Notes" GroupName="nav" />
                    <RadioButton x:Name="NavJournal" Style="{StaticResource Nav}" Tag="&#xE787;" Content="Journal" GroupName="nav" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings" GroupName="nav" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ content -->
        <Grid Grid.Column="1">
            <!-- TODAY -->
            <ScrollViewer x:Name="PageToday" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="44,56,44,40" MaxWidth="860">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="Greeting" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="SemiBold" Text="Good evening." />
                            <TextBlock x:Name="TodayDate" FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button x:Name="TalkMode" Grid.Column="1" Style="{StaticResource Key}" Padding="16,9" VerticalAlignment="Top" ToolTip="A hands-free conversation: it listens again after every answer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F2;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="TalkModeText" Text="Talk mode" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ask -->
                    <Border Margin="0,26,0,0" CornerRadius="18" Background="#17FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="18,6,8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AskHint" Text="Ask Vigil anything…" Foreground="{StaticResource TextFaint}" FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="AskBox" Style="{StaticResource Field}" FontSize="16" VerticalAlignment="Center" Margin="0,8" />
                            <Button x:Name="AskMic" Grid.Column="1" Style="{StaticResource Round}" ToolTip="Talk">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" FontSize="16" />
                            </Button>
                            <Button x:Name="AskSend" Grid.Column="2" Style="{StaticResource Send}" Margin="4,0,0,0" ToolTip="Send">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="15" FontWeight="Bold" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- now + vigil says -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="RIGHT NOW" />
                                <TextBlock x:Name="NowApp" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="-" />
                                <TextBlock x:Name="NowFor" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="VIGIL SAYS" />
                                <TextBlock x:Name="SaysText" FontSize="15" LineHeight="22" TextWrapping="Wrap" Text="Nothing yet - I'll check in when you've been at something a while." />
                                <StackPanel x:Name="SaysActions" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Button x:Name="SaysReply" Style="{StaticResource Primary}" Padding="13,6" FontSize="12.5" Content="Reply" Margin="0,0,6,0" />
                                    <Button x:Name="SaysTalk" Style="{StaticResource Key}" Padding="12,6" FontSize="12.5" Content="Talk" />
                                </StackPanel>
                                <Button x:Name="AdviceButton" Style="{StaticResource Key}" Padding="13,6" FontSize="12.5" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Content="Give me advice" ToolTip="Vigil looks at your day and gives you three suggestions" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- today's apps -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="TODAY ON THIS PC" />
                                <TextBlock x:Name="TodayTotal" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextFaint}" />
                            </Grid>
                            <StackPanel x:Name="AppBars" />
                            <TextBlock x:Name="AppsEmpty" FontSize="13" Foreground="{StaticResource TextDim}" Text="Nothing recorded yet today." Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- recent -->
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="RECENTLY" />
                            <StackPanel x:Name="RecentList" />
                            <TextBlock x:Name="RecentEmpty" FontSize="13" Foreground="{StaticResource TextDim}" Text="Ask Vigil something and it will show up here." Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- NOTES -->
            <Grid x:Name="PageNotes" Visibility="Collapsed" Margin="0,46,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="28,10,12,24">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Notes" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold" />
                        <Button x:Name="NewNote" Style="{StaticResource Round}" HorizontalAlignment="Right" Width="32" Height="32" Tag="16" ToolTip="New note">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="13" />
                        </Button>
                    </Grid>
                    <Border DockPanel.Dock="Top" CornerRadius="10" Background="#12FFFFFF" Padding="11,7" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock x:Name="NoteSearchHint" Text="Search notes" Foreground="{StaticResource TextFaint}" FontSize="13" IsHitTestVisible="False" />
                            <TextBox x:Name="NoteSearch" Style="{StaticResource Field}" FontSize="13" />
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="NoteList" />
                    </ScrollViewer>
                </DockPanel>
                <Border Grid.Column="1" Margin="12,10,32,24" Style="{StaticResource Card}" Padding="26,22">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NoteTitle" Style="{StaticResource Field}" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="NoteStatus" FontSize="12" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button x:Name="NoteDelete" Style="{StaticResource Round}" Width="32" Height="32" Tag="16" ToolTip="Delete note">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" />
                                </Button>
                                <Button x:Name="NoteSave" Style="{StaticResource Primary}" Padding="14,6" FontSize="12.5" Content="Save" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="#14FFFFFF" Margin="0,14,0,14" />
                        <TextBox x:Name="NoteBody" Style="{StaticResource Field}" FontSize="15" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- JOURNAL -->
            <ScrollViewer x:Name="PageJournal" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="44,56,44,40" MaxWidth="860">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Journal" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock x:Name="JournalDay" FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="DayBack" Style="{StaticResource Round}" ToolTip="Earlier day">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="13" />
                            </Button>
                            <Button x:Name="DayToday" Style="{StaticResource Chip}" Content="Today" Margin="4,0" />
                            <Button x:Name="DayNext" Style="{StaticResource Round}" ToolTip="Later day">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="APPS IN FRONT" />
                            <TextBlock x:Name="JournalApps" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="WHAT HAPPENED" />
                            <StackPanel x:Name="JournalList" />
                            <TextBlock x:Name="JournalEmpty" FontSize="13" Foreground="{StaticResource TextDim}" Text="Nothing written on this day." Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="44,56,44,40" MaxWidth="760">
                    <TextBlock Text="Settings" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="SemiBold" />

                    <TextBlock Style="{StaticResource Eyebrow}" Text="YOU" Margin="4,28,0,10" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Your name" FontSize="14" />
                                <TextBlock Text="What Vigil calls you." FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Box}" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="BRAIN" Margin="4,26,0,10" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BrainLine" FontSize="14" />
                                <TextBlock x:Name="BrainHint" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="ChangeBrain" Style="{StaticResource Key}" Content="Change…" HorizontalAlignment="Right" Margin="0" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="VOICE" Margin="4,26,0,10" />
                    <Border Style="{StaticResource Card}" Padding="20,8">
                        <StackPanel x:Name="VoiceSwitches" />
                    </Border>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="AWARENESS" Margin="4,26,0,10" />
                    <Border Style="{StaticResource Card}" Padding="20,8">
                        <StackPanel x:Name="AwareSwitches" />
                    </Border>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="SAFETY" Margin="4,26,0,10" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="When Vigil asks first" FontSize="14" />
                            <StackPanel x:Name="ModeRow" Orientation="Horizontal" Margin="0,12,0,0" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Your mouse, keyboard and screen are asked for every single time, in every mode. Turning off antivirus, the firewall or UAC is blocked, always." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="THIS PC" Margin="4,26,0,10" />
                    <Border Style="{StaticResource Card}" Padding="20,8">
                        <StackPanel x:Name="SystemSwitches" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
